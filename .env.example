# Copy to .env for local development (never commit .env)
POSTGRES_USER=agendo
POSTGRES_PASSWORD=agendo_dev_password
POSTGRES_DB=agendo
DATABASE_URL=postgresql://agendo:agendo_dev_password@localhost:5432/agendo

# Required only for --live-gemini
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-4-hydrogen
